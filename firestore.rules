rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isTeacher() { return signedIn() && profile().role == 'professor'; }
    function ownsClass(cid) {
      return isTeacher() &&
        get(/databases/$(database)/documents/classes/$(cid)).data.teacherId == request.auth.uid;
    }
    function enrolled(cid) {
      return signedIn() && profile().role == 'aluno' &&
        cid in profile().classIds;
    }
    function canReadClass(cid) { return ownsClass(cid) || enrolled(cid); }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isTeacher() &&
        request.resource.data.keys().hasOnly(['name','email','role','teacherId','classIds']) &&
        request.resource.data.role == 'aluno' &&
        request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.classIds is list &&
        request.resource.data.classIds.size() == 1 &&
        get(/databases/$(database)/documents/classes/$(request.resource.data.classIds[0])).data.teacherId == request.auth.uid;
      allow update, delete: if false;
    }
    match /classes/{cid} {
      allow get, list: if signedIn() &&
        (resource.data.teacherId == request.auth.uid && isTeacher() ||
         profile().role == 'aluno' && cid in profile().classIds);
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['name','subject','teacherId','createdAt']);
      allow update, delete: if false;
      match /{kind}/{itemId} {
        allow get, list: if kind in ['contents','activities'] && canReadClass(cid);
        allow create: if kind in ['contents','activities'] && ownsClass(cid) &&
          request.resource.data.keys().hasOnly(['title','body','date','createdAt']) &&
          request.resource.data.title is string && request.resource.data.title.size() <= 180 &&
          request.resource.data.body is string && request.resource.data.body.size() <= 15000;
        allow delete: if kind in ['contents','activities'] && ownsClass(cid);
        allow update: if false;
      }
    }
  }
}