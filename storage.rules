rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){ return request.auth != null; }
  function user(){ return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data; }
  function teacher(cid){ return signedIn() && user().role == 'professor' && firestore.get(/databases/(default)/documents/classes/$(cid)).data.teacherId == request.auth.uid; }
  function enrolled(cid){ return signedIn() && user().role == 'aluno' && cid in user().classIds; }
  match /classFiles/{cid}/{postId}/{fileId} {
   allow read: if teacher(cid) || enrolled(cid);
   allow create: if teacher(cid) && request.resource.size <= 10 * 1024 * 1024
    && request.resource.contentType in ['image/jpeg','image/png','image/webp','application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.oasis.opendocument.text','text/plain'];
   allow delete: if teacher(cid);
   allow update: if false;
  }
 }
}
